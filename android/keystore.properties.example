# Copy this file to `keystore.properties` and fill in your real values.
# `keystore.properties` is git-ignored so your secrets are never committed.
#
# storeFile can be an absolute path, or a path relative to the android/app folder.
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
