# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMOB CONFIGURATION: User-provided production AdMob parameters
VITE_ADMOB_APP_ID="ca-app-pub-5012012151589823~9419970260"
VITE_ADMOB_AD_UNIT_ID="ca-app-pub-5012012151589823/7511992229"

# BACKEND URL for the packaged mobile app (multiplayer, leaderboard, AI endpoints).
# Leave EMPTY for local web dev (same-origin). For the Android/iOS build, set this
# to your deployed backend, e.g. https://hand-cricket.onrender.com
# The app will use wss:// automatically for the WebSocket connection.
VITE_API_BASE_URL=""

# DATABASE (leaderboard persistence). Set on the BACKEND host only (e.g. Render).
# Free option: Neon (https://neon.tech) -> copy the pooled connection string.
# When empty, the server falls back to a local data/leaderboard.json file.
DATABASE_URL=""



